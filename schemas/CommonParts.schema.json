{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/part/CommonParts.schema.json",
  "title": "NGSI v2 Common Attribute Definitions",
  "description": "Commonly used attribute definitions and relationships for NGSI v2 Normalized entities.",
  
  "$defs": {
    
    "TextAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Text" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    
    "NumberAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Number" },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },

    "BooleanAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Boolean" },
        "value": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "ZonesAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Array" },
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zoneName": { "title": "場所大分類", "type": "string" },
              "subzones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subzoneName": {
                      "type": "array",
                      "items": [
                        { "title": "場所中分類", "type": "string" },
                        { "title": "場所小分類", "type": "array", "items": { "type": "string" } }
                      ]
                    }
                  }
                }
              }
            },
            "required": ["zoneName"]
          }
        }
      }
    },

    "ZoneInstalledAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Array" },
        "value": {
          "type": "array",
          "items": [
            { "title": "場所大分類", "type": "string" },
            { "title": "場所中分類", "type": "string" },
            { "title": "場所小分類", "type": "string" }
          ],
          "maxItems": 3
        }
      }
    },

    "IntegerAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Integer" },
        "value": { "type": "integer" }
      },
      "additionalProperties": false
    },

    "ArrayAttributeText": {
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["type", "value"]
    },
    
    "DateAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Date" },
        "value": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    
    "DateTimeAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "DateTime" },
        "value": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    
    "UrlAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "URL" },
        "value": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeOrganization": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Organization:.*", "x-refType": "Organization" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeDepartment": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Department:.*", "x-refType": "Department" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeLandArray": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Array" },
        "value": { "type": "array", "items": { "type": "string", "x-refType": "Land" } }
      },
      "additionalProperties": false
    },

    "RelationshipArrayAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Array" },
        "value": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeOrganizationOrDepartment": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "x-refType": ["Organization", "Department"] }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeReport": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Report:.*", "x-refType": "Report" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeBuildingDeviceOrBuildingComponent": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "x-refType": ["Building", "Device", "BuildingComponent"] }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeDeviceOrBuildingComponent": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "x-refType": ["Device", "BuildingComponent"] }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeDevice": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Device:.*", "x-refType": "Device" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeDeviceModel": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:DeviceModel:.*", "x-refType": "DeviceModel" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeFacility": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Facility:.*", "x-refType": "Facility" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeBuilding": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Building:.*", "x-refType": "Building" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeBuildingComponent": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:BuildingComponent:.*", "x-refType": "BuildingComponent" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeProcedure": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Procedure:.*", "x-refType": "Procedure" }
      },
      "additionalProperties": false
    }
  }
}