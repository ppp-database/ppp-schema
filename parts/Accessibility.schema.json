{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/parts/Accessibility.schema.json",
  "title": "Accessibility",
  "description": "施設・建物のアクセシビリティ情報を表すデータパーツ。https://ppp-database.org/spec/parts/Accessibility/ 参照。属性名は各モデル側で決め、title/descriptionも利用側で$refの兄弟キーとして指定する。",
  "$defs": {
    "Accessibility": {
      "type": "object",
      "x-suggested-name": "accessibility",
      "properties": {
        "type": { "const": "Accessibility" },
        "value": {
          "type": "object",
          "title": "アクセシビリティー",
          "properties": {
            "wheelchairAccessible": { "title": "車椅子可", "type": "boolean", "description": "車椅子の使用可" },
            "wheelchairRental": { "title": "車椅子貸出", "type": "boolean", "description": "車椅子貸出有り" },
            "caneRental": { "title": "ツエ貸出", "type": "boolean", "description": "ツエ貸出有り" },
            "multipurposeToilet": { "title": "バリアフリートイレ", "type": "boolean", "description": "多目的トイレ有り" },
            "ramp": { "title": "スロープ", "type": "boolean", "description": "スロープ有り" },
            "elevator": { "title": "エレベータ", "type": "boolean", "description": "エレベータ有り" },
            "escalator": { "title": "エスカレーター", "type": "boolean", "description": "エスカレーター有り" },
            "mobilitySupportForBrailleBlocks": { "title": "点字ブロック等の移動支援", "type": "boolean", "description": "点字ブロック等の移動支援有り" },
            "brailleAndReadingAssistance": { "title": "点字や読上による支援", "type": "boolean", "description": "点字や読上による支援有り" },
            "accompaniedByGuideDogsAndServiceDogs": { "title": "盲導犬・介助犬・聴導犬同伴", "type": "boolean", "description": "盲導犬・介助犬・聴導犬などの同伴可" },
            "subtitles": { "title": "字幕", "type": "boolean", "description": "字幕有り" },
            "writingSupport": { "title": "筆談対応", "type": "boolean", "description": "筆談対応有り" },
            "toiletForOstomates": { "title": "オストメイト対応トイレ", "type": "boolean", "description": "オストメイト対応トイレ有り" },
            "remarks": { "title": "備考", "type": "string", "description": "その他アクセシビリティ事項" },
            "priorityParking": { "title": "優先駐車場", "type": "boolean", "description": "優先駐車場有り" },
            "publicPhoneForWheelchairUsers": { "title": "車椅子対応公衆電話", "type": "boolean", "description": "車椅子対応公衆電話有り" },
            "barrierFreeFloor": { "title": "バリアフリー床", "type": "boolean", "description": "段差無し" },
            "handrail": { "title": "手すり", "type": "boolean", "description": "手すり有り" },
            "automaticDoor": { "title": "自動ドア", "type": "boolean", "description": "自動ドア有り" }
          }
        }
      },
      "required": ["type", "value"],
      "additionalProperties": false
    }
  }
}
