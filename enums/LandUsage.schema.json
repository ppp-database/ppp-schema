    "LandUsageAggregateEnum": {
      "type": "string",
      "enum": [
        "農地",
        "宅地",
        "道路・鉄軌道敷",
        "空地"
      ],
      "x-enumDescriptions": {
        "農地": ["田、畑の区分がない", "260"],
        "宅地": ["住宅用地、商業用地等の区分が無い", "261"],
        "道路・鉄軌道敷": ["道路と交通施設用地が混在", "262"],
        "空地": ["その他①～④の区分が無い", "263"]
      }
