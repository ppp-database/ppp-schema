{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Facility/",
  "title": "施設",
  "type": "object",
  "properties": {
    "id": {
      "title": "施設ID",
      "type": "string",
      "description": "NGSI V2に準拠する際の[主キー](https://ppp-database.org/howtouse/terms-2/#主キー)です。一旦割り当てた施設IDは変更する事はできません。。NGSI-LDの仕様に合わせ、次の形式の識別子とします。“urn:ngsi-ld:Facility:”<通番>。<通番>は全ての施設で一意となる文字列です。例えば採番時に施設を所有する法人の<国名コード><法人番号>-<管理通番>などです。ここでいう管理通番はオーナーの法人内で施設を一意に識別する文字列です。尚、オーナーの法人が替わるなどにより法人番号や管理通番が変わっても、施設として継続している場合はこの施設IDは変更してはならない決まりです。"
    },
    "type": {
      "const": "Facility",
      "description": "必ず“Facility”の文字列でなくてはならない決まりです。NGSI V2に準拠しない場合は不要です。"
    },
    "name": {
      "title": "施設名",
      "description": "正式な施設名を日本語で設定する",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nameKana": {
      "title": "施設名カナ",
      "description": "施設のカナ表記を設定する。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nameEn": {
      "title": "施設名英語",
      "description": "施設の米国英語表記を設定する",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "alternateName": {
      "title": "通称",
      "description": "住民や来街者からの問い合わせや掲示などで使われる一般的な通称がある場合はリスト構造で列挙します。公共施設ドメインの場合、省略すると通称はないと解釈されます",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "facilityID": {
      "title": "管理通番",
      "description": "オーナーが管理対象の施設を区別するために付番した文字列です。事業者によっては施設IDや施設番号などと表現する事がありますが、項目の呼称「施設ID(id)」と混同する可能性があるため共通データ仕様では管理通番と表現しています。施設管理では基本的にこの「施設(Facility)」を管理単位としますが、データ仕様上は「建物(Building)」を管理対象とすることも可能です。本項目は管理対象をFacilityとする場合には必須です。また複合施設等に入居するテナント施設の場合もデータ管理上附番しておくことが望ましいです。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "category": {
      "title": "施設大分類",
      "description": "施設の分類。[GIF](https://ppp-database.org/howtouse/terms-g/#gif)のPOIの大分類の名称を登録。必ずしも該当する分類があるとは限らない。例えば“給食センター”などはない",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "subcategory": {
      "title": "施設小分類",
      "description": "施設の分類。[GIF](https://ppp-database.org/howtouse/terms-g/#gif)のPOIの小分類の名称を登録。必ずしも該当する分類があるとは限らない。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "originalCategory": {
      "title": "施設分類",
      "description": "POI以外の分類がある場合に登録。独自の分類で構わない。分類が階層構造になっている場合は大まかな分類から順にリストで登録",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "abstract": {
      "title": "施設概要",
      "description": "施設情報として公開可能なリード文です。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "title": "施設説明",
      "description": "施設の概要を記載します。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "title": "ステータス",
      "description": "施設の状態です。“計画中”、“準備中”、“稼働中”、“一時閉鎖”、“閉鎖中”、“廃止”などを登録します。施設が廃止されても、統計データや分析データは残るためこのデータモデルのデータも削除できません。そこで、この項目に“廃止”などと記述する事で存在する施設の情報なのかどうかを区別します。この項目には用語は定義されていません。定義が必要な場合はこのページの一番上の「コメント投稿」から事務局に連絡してください。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "shelter": {
      "title": "防災施設情報",
      "description": "防災施設を示す属性。例えば[“指定緊急避難場所”, “洪水”, “地震”]など",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "postalCode": {
      "title": "個別郵便番号",
      "x-partType": "PostalCode",
      "description": "施設が個別郵便番号を有する場合に登録する。このAttributeに登録が無い場合は、リンクを辿ってLandのpostalCodeを参照する",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "refBuilding": {
      "title": "建物ID",
      "description": "入居するBuilding(建物)へのリンクです。リンクを辿ることで住所)やビル名を求めることができます",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:Building:.*",
          "x-refType": "Building"
        }
      },
      "additionalProperties": false
    },
    "floor": {
      "title": "フロア",
      "description": "入居する建物内の位置。方書にフロア情報も必要な場合に登録",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "openingHours": {
      "title": "開館時間帯",
      "description": "曜日ごとの開館閉館時刻の配列。",
      "type": "object",
      "x-suggested-name": "openingHours",
      "properties": {
        "type": {
          "const": "OpeningHours"
        },
        "value": {
          "title": "開館時間帯",
          "description": "サービスを提供する時間帯を表す文字列のリストです。リストの中の各要素の文字列は曜日、開館時刻、閉館時刻を以下の形式で表現します。\n　“<曜日>(空白)<開始時刻>-<終了時刻>”\n曜日はMo,Tu,We,Th,Fr,Sa,Suの2文字で表現し、カンマ区切りで複数の曜日を並べたり、連続する曜日をハイフンで繋いで範囲指定したりできます。例えば、“Mo-Fr 09:00-17:00”など。(空白)は半角のブランク文字です。\n開始時刻・終了時刻はHH:MMの24時間形式で表現します。開始時刻が終了時刻より大きい場合は、夜間を通じて開館していると解釈します。",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "openingHoursRemarks": {
      "title": "開館時間補足",
      "description": "openingHoursの定型では表現できない施設の利用日時情報",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "chargeType": {
      "title": "料金種別",
      "description": "料金の種別。“有料”、“年額”、“月額”、“無料”などです。",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "price": {
      "title": "料金",
      "description": "施設利用に必要な基本料金を日本円で記載(1円単位)",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Integer"
        },
        "value": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "priceRemarks": {
      "title": "料金備考",
      "description": "料金の備考。例: “１グループ1000円”、または“大人１名1500円、子供１名500円(18歳以下)、65歳以上１名1000円”など",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "paymentMethod": {
      "title": "決済種別",
      "description": "料金の支払方法。列挙型項目。列挙型メンバは、[http://schema.org/paymentMethod](http://schema.org/paymentMethod)を参照",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "peopleCapacity": {
      "title": "収容人数",
      "description": "定員",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Integer"
        },
        "value": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "accessMethod": {
      "title": "アクセス方法",
      "description": "公共交通や車でのアクセス方法を記載します。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "refOffStreetParking": {
      "title": "駐車場ID",
      "description": "駐車場情報のid。駐車可能な台数などの説明、料金、優先駐車場の有無などを辿れる。データモデルはSmart Data Modelsの[OffStreetParking](https://github.com/smart-data-models/dataModel.Parking/tree/a8d826a5ba45ccfe2f4d35273a5c4bfb05d85117/OffStreetParking)を参照されたい",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "areaServed": {
      "title": "サービス担当区域",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "region": {
                    "title": "都道府県",
                    "type": "string"
                  },
                  "subRegion": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "locality": {
                          "title": "市区町村",
                          "type": "string"
                        },
                        "street": {
                          "title": "町字以下",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
