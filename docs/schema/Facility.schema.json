      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contactPoint": {
      "title": "連絡先",
      "description": "施設の代表電話などを登録する",
      "type": "object",
      "x-suggested-name": "contactPoint",
      "properties": {
        "type": {
          "const": "ContactPoint"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "availableLanguage": {
                "title": "対応言語",
                "type": "string",
                "description": "対応できる言語を記述します。IETF BCP 47 standardに従います。日本語では“ja”です。"
              },
              "contactType": {
                "title": "連絡先種別",
                "description": "連絡の種別を記述します。列挙型項目であり、用語の定義は「[連絡先種別(ContactPointType)](https://ppp-database.org/spec/enum/ContactPointType/)」を参照してください。",
                "type": "string",
                "enum": [
                  "不具合連絡",
                  "予約",
                  "警備",
                  "総合",
                  "その他"
                ],
                "x-enumDescriptions": {
                  "不具合連絡": "施設や設備に不具合があったときに連絡する連絡先です",
                  "予約": "予約、予約の変更、予約の確認など、予約に関する連絡先です",
                  "警備": "警備関連の連絡先です",
                  "総合": "総合窓口の連絡先です。代表電話を含みます",
                  "その他": "その他の連絡先です"
                }
              },
              "email": {
                "title": "メールアドレス",
                "type": "string",
                "format": "email",
                "description": "連絡先メールアドレスです。"
              },
              "telephone": {
                "title": "電話番号",
                "type": "array",
                "items": {
                  "type": "string",
                  "x-partType": "Telephone"
                },
                "description": "電話番号、携帯電話番号です。電話番号は“+-0123456789”の文字からなる文字列とし、“+”は文字列の先頭のみ許されます。詳しくは[データパーツの説明](https://ppp-database.org/spec/parts/telephone/)を参照して下さい。"
              },
              "extension": {
                "title": "内線番号",
                "type": "string",
                "description": "内線番号です。"
              },
              "formURL": {
                "title": "フォーム",
                "type": "string",
                "format": "uri",
                "description": "連絡先がWebフォームの場合のURLです。"
              },
              "faxNumber": {
                "title": "FAX",
                "type": "string",
                "description": "ファックスの電話番号です。記述はtelephoneと同じ形式とします。自治体標準オープンデータセットの介護サービス事業所一覧および医療機関一覧のために追加しました。"
              }
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
