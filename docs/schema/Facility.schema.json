                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "required": [
                "type",
                "coordinates"
              ]
            }
          ]
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "この施設がサービスを提供する区域をポリゴンで指定する。前項とどちらかしか登録できない"
    },
    "areaServedaRemarks": {
      "title": "サービス担当区域備考",
