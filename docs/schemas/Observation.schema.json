{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Observation/",
  "title": "NGSI v2 Observation Entity (Normalized) - Procedure Step Result",
  "type": "object",
  "required": [
    "id",
    "type",
    "performedAt",
    "results",
    "refProcedure",
    "refFeatureOfInterest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:ngsi-ld:Observation:.*",
      "description": "測定値や確認結果を一意に識別する識別子です。この項目はNGSI V2仕様における[主キー](https://ppp-database.org/howtouse/terms-2/#主キー)ですので、一旦割り当てた案件IDは変更する事はできません。\nNGSI-LDの仕様に合わせ、次の形式の識別子とします。\n　“urn:ngsi-ld:Observation”<一意となる文字列>\n<一意となる文字列>は一意となる文字列であれば何でも構いませんが、本項目値全体でurnの規格に合致する必要があります。",
      "title": "観測活動ID"
    },
    "type": {
      "type": "string",
      "const": "Observation",
      "description": "必ず“Observation”の文字列でなくてはならない決まりです。NGSI V2に準拠しない場合は不要です。"
    },
    "stepType": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string",
          "enum": [
            "measurement",
            "check",
            "sample"
          ]
        }
      },
      "additionalProperties": false,
      "description": "「[観測手順 (Procedure)](https://ppp-database.org/spec/datamodel/Procedure/)」で定義した各「作業項目 (steps)」のstepTypeです。定義した手順の場合は必須ですが、定義していない作業の場合は省略します。",
      "title": "作業タイプ"
    },
    "refProcedure": {
      "description": "この観測活動が基づく「[観測手順 (Procedure)](https://ppp-database.org/spec/datamodel/Procedure/)」のIDです。「観測手順」で定義した「手順ID」です。手順に基づく観測活動の場合は必須です。",
      "title": "手順ID",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:Procedure:.*",
          "x-refType": "Procedure"
        }
      },
      "additionalProperties": false
    },
    "name": {
      "description": "「[観測手順 (Procedure)](https://ppp-database.org/spec/datamodel/Procedure/)」に基づく場合は「観測手順」内の「作業項目 (ProcedureSteps)」の各ステップで定義した「作業名」です。手順に基づく作業の場合は、手順IDとこの作業名またはステップ番号で作業を特定できるため、どちらかは必須です。尚、ステップ番号で識別する場合も作業名を付与する事を推奨します。",
      "title": "作業名",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stepNumber": {
      "description": "「[観測手順 (Procedure)](https://ppp-database.org/spec/datamodel/procedure/)」に基づく場合は「観測手順 (Procedure)」内の「作業指示 (ProcedureSteps)」で定義した「ステップ番号」です。",
      "title": "ステップ番号",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Number"
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "description": "この観測活動に関する概要説明です。",
      "title": "説明",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "performedAt": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "DateTime"
            },
            "value": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Standard NGSI Array Attribute for a DateTime range",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "Array"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date-time"
              },
              "minItems": 1,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "観測活動を実施した日時です。開始と終了を明示する必要がある時は、2項目のArrayで開始日時・終了日時の順番で指定します。",
      "title": "実施日時"
    },
    "operator": {
      "description": "実施主体を区別するための情報です。データを流通する観点から個人名は望ましくありません。",
      "title": "実施者",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "refFeatureOfInterest": {
      "description": "観測対象の「設備」「部位」「備品」をリンクするためのそれぞれのIDです。",
      "title": "観測対象",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "x-refType": [
            "Device",
            "BuildingComponent"
          ]
        }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "value"
                ],
                "properties": {
                  "observedProperty": {
                    "type": "string",
                    "title": "観測特性",
                    "description": "作業が測定であった時、実際に測定した属性。温度、湿度、圧力など。列挙型項目であり、用語の定義は「[制御対象(ControlledProperty)](https://ppp-database.org/spec/enum/ControlledProperty/)」を参照して下さい。"
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "array",
                      "object"
                    ],
                    "title": "測定値",
                    "description": "作業が測定であった時、測定値。値は数値とは限りません。"
                  },
                  "unit": {
                    "type": "string",
                    "title": "単位",
                    "description": "測定値の単位です。単位は基本的にJIS Z 8000に従う必要があります。業界標準などの単位を採用する場合でも、JISに機械的に変換できることが望ましいです。"
                  },
                  "precision": {
                    "type": "number",
                    "title": "精度",
                    "description": "測定値の精度です。"
                  },
                  "thresholdBreached": {
                    "type": "string",
                    "title": "逸脱閾値名",
                    "description": "逸脱した閾値。最も重篤な閾値名を記述する。但し、逸脱していなくても記述して明示的に“閾値内”を設定しても構いません。"
                  },
                  "actionTaken": {
                    "type": "string",
                    "title": "処置",
                    "description": "実際に行った処置を記述します。例えば、閾値を逸脱した場合に実施した処置などです。"
                  },
                  "notes": {
                    "type": "string",
                    "title": "補足",
                    "description": "補足です。"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "observedState",
                  "match"
                ],
                "properties": {
                  "observedState": {
                    "type": "string",
                    "title": "観測状態",
                    "description": "「期待状態(expectedState)」に対し実際に確認した状態です。"
                  },
                  "match": {
                    "type": "boolean",
                    "title": "一致",
                    "description": "期待状態と観測状態が一致している場合にはtrue、一致しない場合はfalseを登録します。"
                  },
                  "actionTaken": {
                    "type": "string",
                    "title": "処置",
                    "description": "実際に行った処置を記述します。例えば、期待値と異なっていた場合に実施した処置などです。"
                  },
                  "notes": {
                    "type": "string",
                    "title": "補足",
                    "description": "補足です。"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "sampleId"
                ],
                "properties": {
                  "sampleId": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "title": "サンプルID",
                    "description": "採取したサンプルを識別する識別子です。この識別子は共通データ仕様では定義しません。運用毎に定義する必要があります。"
                  },
                  "notes": {
                    "type": "string",
                    "title": "補足",
                    "description": "補足です。"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "description": "観測結果と共に、付随する情報を登録する構造体です。付随する情報とは、例えば室温の測定結果と共に、外気温や日照量などの分析に役立つ情報を指します。主たる測定結果はArray内の一つ目の要素に格納します。このArrayの要素には以下のみっつの形式があります。",
      "title": "観測結果"
    }
  }
}
