{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/OpenData/",
  "title": "公開管理",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "datasetSpec",
    "sources",
    "refCreator"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:ngsi-ld:OpenData:.*",
      "description": "NGSI V2に準拠する際の[主キー](https://ppp-database.org/howtouse/terms-2/#主キー)です。一旦割り当てたIDは変更できません。NGSI-LDの仕様に合わせ、次の形式とします。“urn:ngsi-ld:OpenData:”<通番>",
      "title": "オープンデータID"
    },
    "type": {
      "const": "OpenData",
      "description": "必ず“OpenData”の文字列でなくてはならない決まりです。NGSI V2に準拠しない場合は不要です。"
    },
    "title": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "title": "タイトル",
      "description": "データセットの名称です。例: “○○市公共施設一覧”"
    },
    "abstract": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "title": "概要",
      "description": "データセットの内容の概要です。"
    },
    "keyword": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "title": "キーワード",
      "description": "データセットを検索するためのキーワードのリストです。"
    },
    "theme": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "title": "分類",
      "description": "データセットの分類です。"
    },
    "universalMenu": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "title": "ユニバーサルメニュー",
      "description": "ユニバーサルメニューによる分類です。"
    },
    "language": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "title": "言語",
      "description": "データセットが記述されている言語です。ISO 639-1に準拠した2文字コードで記載します（例: “ja”、“en”）。"
    },
    "conformsTo": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "title": "準拠標準",
      "description": "データセットが準拠する標準です。自治体標準オープンデータセットに準拠している場合は“自治体標準オープンデータセット”と入力します。"
    },
    "spatial": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "title": "対象地域",
      "description": "データセットが対象とする地域を示すメモです。このデータセットが実際にカバーする地理的範囲を記述します。エンティティの収集条件ではありません。"
    },
    "refCreator": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:Department:.*",
          "x-refType": "Department"
        }
      },
      "additionalProperties": false,
      "title": "作成者",
      "description": "データセットの作成を担当する部門（Department）へのリンクです。"
    },
    "refContactPoint": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:Department:.*",
          "x-refType": "Department"
        }
      },
      "additionalProperties": false,
      "title": "連絡先",
      "description": "データセットに関する問い合わせ先の部門（Department）へのリンクです。作成者と異なる場合に登録します。"
    },
    "remarks": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "title": "備考",
      "description": "データセットの特記事項です。"
    },
    "datasetSpec": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "title": "データセット仕様",
      "description": "出力する公開フォーマット仕様を名前空間付きで指定します。例: “ODS:01.公共施設一覧”、“ODS:07.公衆無線LANアクセスポイント一覧”、“AreaData:公共施設”。JtoCがこの値を参照してマッピング定義を選択します。"
    },
    "sources": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "entityType"
            ],
            "properties": {
              "entityType": {
                "type": "string",
                "title": "対象エンティティ種別",
                "description": "収集対象のNGSI V2エンティティのtype値です。例: “Facility”、“Device”"
              },
              "filterCriteria": {
                "type": "array",
                "title": "選択条件",
                "description": "このエンティティ種別に対する絞り込み条件です。各条件はANDで結合されます。省略時はentityTypeの全エンティティを収集します。refEntitiesが設定されている場合は無視されます。",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "value"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "title": "属性パス",
                      "description": "対象エンティティの属性名、またはRelationshipを辿った先の属性名をドット区切りで指定します。例: “status”、“refDepartment.departmentOf.localGovernmentCode”"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "==",
                        "!=",
                        "in"
                      ],
                      "default": "==",
                      "title": "演算子",
                      "description": "比較演算子です。省略時は“==”とみなします。“in”を指定した場合はvalueを配列にします。"
                    },
                    "value": {
                      "title": "比較値",
                      "description": "比較する値です。“op”が“in”の場合は配列を指定します。"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "refEntities": {
                "type": "array",
                "title": "対象エンティティ一覧",
                "description": "このエンティティ種別の収集対象IDをurn:ngsi-ld:...形式で静的に列挙します。設定されている場合はfilterCriteriaより優先されます。",
                "items": {
                  "type": "string",
                  "pattern": "^urn:ngsi-ld:.*"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "title": "収集元",
      "description": "収集対象エンティティの種別と絞り込み条件を定義します。複数のエンティティ種別を列挙できます。各エンティティ種別ごとに独立した条件を指定できます。"
    }
  }
}
